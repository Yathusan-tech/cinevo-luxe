# ==============================================================================
# CINEVO LUXE - Environment Configuration Template
# ==============================================================================
# IMPORTANT:
# 1. Copy this file to .env: cp .env.example .env
# 2. Set your production secrets in .env
# 3. NEVER commit the .env file or real secrets to version control.
# ==============================================================================

# Primary Secret Key for cryptographic session signing and CSRF tokens (REQUIRED in production)
CINEVO_SECRET_KEY=replace_with_a_cryptographically_secure_random_64_char_hex_string

# Standard Secret Key (fallback compatibility)
SECRET_KEY=

# Application Environment Mode (development / production)
FLASK_ENV=development
DEBUG=False

# Session Cookie Security (Set to True in production when deployed behind HTTPS/TLS)
SESSION_COOKIE_SECURE=False

# Database URL (Optional: Defaults to local SQLite database in instance/database.db)
# Example for PostgreSQL: postgresql://user:password@localhost:5432/cinevo_db
# DATABASE_URL=

# Port for local server runner (Default: 5000)
PORT=5000
