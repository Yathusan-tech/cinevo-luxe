# Environment Configuration Example
# Copy this file to .env for local development

FLASK_APP=app.py
FLASK_ENV=development
DEBUG=False

# Generate a strong secret key for your environment
SECRET_KEY=your_secret_key_here

# Database URI
DATABASE_URL=sqlite:///database.db

# Optional initial staff credentials
STAFF_ADMIN_USER=your_admin_username
STAFF_ADMIN_PASS=your_admin_password
